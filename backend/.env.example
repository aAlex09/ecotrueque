# =============================================================================
# CONFIGURACIÓN DE ECOTRUEQUE
# =============================================================================
# Copia este archivo a .env y actualiza con tus valores reales
# IMPORTANTE: NUNCA subir .env a GitHub (está en .gitignore)

# =============================================================================
# BASE DE DATOS - PostgreSQL
# =============================================================================
# Formato: postgresql://usuario:password@host:puerto/nombre_db
# Ejemplo local: postgresql://postgres:123456@localhost:5432/ecotrueque
DATABASE_URL=postgresql+psycopg2://postgres:123456789@localhost:5432/ecotrueque

# =============================================================================
# SEGURIDAD - JWT
# =============================================================================
# Clave secreta para firmar JWT tokens (GENERAR UNA ALEATORIA FUERTE)
# Linux/Mac: openssl rand -hex 32
# Windows (PowerShell): [System.Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes((Get-Random -Count 32 | % {[char]$_})))
SECRET_KEY=CAMBIA_ESTE_SECRETO_POR_UNA_CLAVE_ALEATORIA_FUERTE

# Algoritmo JWT (no cambiar)
ALGORITHM=HS256

# Expiración de tokens en minutos (60 = 1 hora)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =============================================================================
# CORS - URLs del Frontend
# =============================================================================
# URLs permitidas para CORS (separadas por comas si hay varias)
CORS_ORIGINS=http://localhost:4200
